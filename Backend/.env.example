# "openai" (needs OPENAI_API_KEY) or "demo" for the offline canned model.
MODEL_PROVIDER=openai
# Your own provider key. Keep it in Backend/.env only; never in a frontend variable.
OPENAI_API_KEY=
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
# Server-side deadline for one model call, in milliseconds (1000-120000).
MODEL_TIMEOUT_MS=40000
