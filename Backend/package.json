{
  "name": "mastra-agent-demo-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express API in front of two Mastra agents with local tools",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.106",
    "@mastra/core": "^1.82.0",
    "ai": "7.0.160",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
